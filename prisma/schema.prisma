model Customer {
    id                String   @id @default(uuid()) @db.Char(36)
    tenant_id         String   @db.Char(36)
    store_id          String?  @db.Char(36)
    full_name         String   @db.VarChar(160)
    document_id       String?  @db.VarChar(80)
    email             String?  @db.VarChar(160)
    phone             String?  @db.VarChar(30)
    birth_date        DateTime? @db.Date
    nickname          String?  @db.VarChar(80)
    avatar_url        String?  @db.Text
    verified          Boolean  @default(false)
    verified_at       DateTime? @db.DateTime(0)
    verified_by_user_id String? @db.Char(36)
    status            String   @default("active") @db.VarChar(30)
    notes             String?  @db.Text
    created_at        DateTime @default(now()) @db.DateTime(0)
    updated_at        DateTime @default(now()) @db.DateTime(0)

    @@map("customers") // Mapeo de la tabla correspondiente
}

model Customer_Document {
    id              String @id @default(uuid()) @db.Char(36)
    customer_id     String @db.Char(36)
    type            String @db.VarChar(40)
    document_number String? @db.VarChar(80)
    country_code    String? @db.VarChar(10)
    status          String @default("active") @db.VarChar(30)
    created_at      DateTime @default(now()) @db.DateTime(0)
    updated_at      DateTime @default(now()) @db.DateTime(0)

    @@map("customer_documents") // Asegúrate de que se mapee correctamente
}

model Customer_Document_Image {
    id          String @id @default(uuid()) @db.Char(36)
    document_id String @db.Char(36)
    image_url   String @db.Text
    label       String? @db.VarChar(80)
    created_at  DateTime @default(now()) @db.DateTime(0)

    @@map("customer_document_images") // Asegúrate de que se mapee correctamente
}